# Copia este archivo como .env.local (ignorado por Git) y completa los valores.
# Local: salen de `npx supabase status`. Producción: se configuran en Vercel, nunca en el repositorio.

# Valores públicos: llegan al navegador. La protección real son las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# La clave secreta de Supabase (sb_secret_...) NO se usa en esta aplicación. No la agregues aquí.

# Dirección secreta del panel (solo servidor, NUNCA con prefijo NEXT_PUBLIC_). 16 a 64 caracteres:
# letras, números, guion o guion bajo. Sin este valor el panel queda desactivado.
ADMIN_ACCESS_PATH=
